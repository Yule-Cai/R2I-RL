<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rulepatch_ros</name>
  <version>0.1.0</version>
  <description>RulePatchNet M2: learned local path repair + auto replan/rollback for RuleSync-Nav.</description>
  <maintainer email="r2i@example.com">R2I-RL</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>rulesync_interfaces</depend>
  <exec_depend>ros2action</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
